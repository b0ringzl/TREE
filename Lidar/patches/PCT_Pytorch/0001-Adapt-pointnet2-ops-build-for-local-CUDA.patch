From 61d65cd4e2d48c3e17b831e58efbda555a0dc519 Mon Sep 17 00:00:00 2001
From: zhenglin <zhenglin9587@outlook.com>
Date: Tue, 30 Jun 2026 13:35:50 +0800
Subject: [PATCH 1/2] Adapt pointnet2 ops build for local CUDA

---
 pointnet2_ops_lib/setup.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pointnet2_ops_lib/setup.py b/pointnet2_ops_lib/setup.py
index faf7154..6f1dd5d 100644
--- a/pointnet2_ops_lib/setup.py
+++ b/pointnet2_ops_lib/setup.py
@@ -16,7 +16,7 @@ requirements = ["torch>=1.4"]
 
 exec(open(osp.join("pointnet2_ops", "_version.py")).read())
 
-os.environ["TORCH_CUDA_ARCH_LIST"] = "3.7+PTX;5.0;6.0;6.1;6.2;7.0;7.5"
+os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "12.0")
 setup(
     name="pointnet2_ops",
     version=__version__,
@@ -29,7 +29,7 @@ setup(
             sources=_ext_sources,
             extra_compile_args={
                 "cxx": ["-O3"],
-                "nvcc": ["-O3", "-Xfatbin", "-compress-all"],
+                "nvcc": ["-O3", "-Xfatbin", "-compress-all", "-allow-unsupported-compiler"],
             },
             include_dirs=[osp.join(this_dir, _ext_src_root, "include")],
         )
-- 
