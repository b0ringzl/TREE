diff --git a/point_cache.py b/point_cache.py
new file mode 100644
index 0000000..7fcf64c
--- /dev/null
+++ b/point_cache.py
@@ -0,0 +1,34 @@
+from pathlib import Path
+
+import torch
+
+
+def sample_points(points, cache_points, seed):
+    points = points.float()
+    generator = torch.Generator()
+    generator.manual_seed(int(seed))
+    point_count = len(points)
+    if point_count >= cache_points:
+        indices = torch.randperm(point_count, generator=generator)[:cache_points]
+    else:
+        indices = torch.randint(point_count, (cache_points,), generator=generator)
+    return points[indices].contiguous()
+
+
+def write_point_cache(tree_id, points, source_path, output_dir, cache_points, seed):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    source_path = Path(source_path)
+    cache_path = output_dir / f"{int(tree_id):05d}.pt"
+    cached_points = sample_points(points, cache_points, seed)
+    torch.save(
+        {
+            "tree_id": int(tree_id),
+            "source": source_path.name,
+            "num_source_points": int(len(points)),
+            "cache_points": int(cache_points),
+            "points": cached_points,
+        },
+        cache_path,
+    )
+    return cache_path
diff --git a/tests/test_point_cache_builder.py b/tests/test_point_cache_builder.py
new file mode 100644
index 0000000..a90e3da
--- /dev/null
+++ b/tests/test_point_cache_builder.py
@@ -0,0 +1,36 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+import torch
+
+import point_cache
+
+
+class PointCacheBuilderTest(unittest.TestCase):
+    def test_write_point_cache_saves_fixed_size_tensor_and_metadata(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            out_dir = Path(tmp) / "cache"
+            points = torch.arange(30, dtype=torch.float32).reshape(10, 3)
+
+            cache_path = point_cache.write_point_cache(
+                tree_id=70,
+                points=points,
+                source_path=Path("00070.laz"),
+                output_dir=out_dir,
+                cache_points=4,
+                seed=123,
+            )
+            payload = torch.load(cache_path, map_location="cpu")
+
+        self.assertEqual(cache_path.name, "00070.pt")
+        self.assertEqual(payload["tree_id"], 70)
+        self.assertEqual(payload["source"], "00070.laz")
+        self.assertEqual(payload["num_source_points"], 10)
+        self.assertEqual(payload["cache_points"], 4)
+        self.assertEqual(tuple(payload["points"].shape), (4, 3))
+        self.assertEqual(payload["points"].dtype, torch.float32)
+
+
+if __name__ == "__main__":
+    unittest.main()
