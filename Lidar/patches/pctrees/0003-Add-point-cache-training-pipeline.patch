+++ b/tests/test_point_cache_dataset.py
@@ -0,0 +1,47 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+import pandas as pd
+import torch
+
+from dataset import MpalaTreeLiDAR
+import utils
+
+
+class PointCacheDatasetTest(unittest.TestCase):
+    def test_dataset_loads_cached_tensor_by_tree_id(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            cache_dir = root / "cache"
+            cache_dir.mkdir()
+            torch.save(
+                {
+                    "tree_id": 70,
+                    "points": torch.arange(12, dtype=torch.float32).reshape(4, 3),
+                    "num_source_points": 100,
+                },
+                cache_dir / "00070.pt",
+            )
+            labels = pd.DataFrame(
+                [{"tree_id": 70, "label": "Acacia", "num_points": 100}]
+            )
+
+            dataset = MpalaTreeLiDAR(
+                dir=str(root / "raw"),
+                labels=labels,
+                min_points=4,
+                top_species=None,
+                transform=utils.ToPointCloud(),
+                cache_dir=str(cache_dir),
+            )
+
+            points, label = dataset[0]
+
+        self.assertEqual(dataset.classes, ["Acacia"])
+        self.assertEqual(label, 0)
+        self.assertTrue(torch.equal(points, torch.arange(12, dtype=torch.float32).reshape(4, 3)))
+
+
+if __name__ == "__main__":
+    unittest.main()
