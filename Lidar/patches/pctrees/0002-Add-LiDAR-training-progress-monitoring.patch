+import csv
+from pathlib import Path
+import tempfile
+import unittest
+
+import pct_main
+
+
+class ProgressLogTest(unittest.TestCase):
+    def test_append_progress_row_creates_header_and_row(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            progress_path = Path(tmp) / "progress.csv"
+
+            pct_main.append_progress_row(
+                progress_path,
+                {
+                    "experiment": "unit",
+                    "stage": "train",
+                    "epoch": 1,
+                    "total_epochs": 2,
+                    "batch": 3,
+                    "total_batches": 10,
+                    "percent": 30.0,
+                    "loss": 1.25,
+                    "accuracy": 0.5,
+                    "samples_seen": 24,
+                    "total_samples": 80,
+                    "elapsed_sec": 4.0,
+                    "eta_sec": 10.0,
+                },
+            )
+
+            with progress_path.open(newline="", encoding="utf-8") as fh:
+                rows = list(csv.DictReader(fh))
+
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0]["experiment"], "unit")
+        self.assertEqual(rows[0]["stage"], "train")
+        self.assertEqual(rows[0]["batch"], "3")
+        self.assertEqual(rows[0]["percent"], "30.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
