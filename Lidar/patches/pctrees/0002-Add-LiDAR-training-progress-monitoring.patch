+PROGRESS_FIELDS = [
+    "timestamp",
+    "experiment",
+    "stage",
+    "epoch",
+    "total_epochs",
+    "batch",
+    "total_batches",
+    "percent",
+    "loss",
+    "accuracy",
+    "samples_seen",
+    "total_samples",
+    "elapsed_sec",
+    "eta_sec",
+]
+
+
+def append_progress_row(progress_path, row):
+    progress_path = Path(progress_path)
+    progress_path.parent.mkdir(parents=True, exist_ok=True)
+    write_header = not progress_path.exists()
+    normalized = {field: row.get(field, "") for field in PROGRESS_FIELDS}
+    normalized["timestamp"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    with progress_path.open("a", newline="", encoding="utf-8") as fh:
+        writer = csv.DictWriter(fh, fieldnames=PROGRESS_FIELDS)
+        if write_header:
+            writer.writeheader()
+        writer.writerow(normalized)
+
+
+def progress_row(args, stage, epoch, batch, total_batches, loss, accuracy, samples_seen, total_samples, stage_start):
+    elapsed = max(time.time() - stage_start, 0.0)
+    percent = 100.0 * batch / total_batches if total_batches else 100.0
+    eta = elapsed / batch * (total_batches - batch) if batch else 0.0
+    return {
+        "experiment": args.exp_name,
+        "stage": stage,
+        "epoch": epoch + 1,
+        "total_epochs": args.epochs,
+        "batch": batch,
+        "total_batches": total_batches,
+        "percent": round(percent, 2),
+        "loss": round(float(loss), 6),
+        "accuracy": round(float(accuracy), 6),
+        "samples_seen": int(samples_seen),
+        "total_samples": int(total_samples),
+        "elapsed_sec": round(elapsed, 2),
+        "eta_sec": round(eta, 2),
+    }
 
