<Window x:Class="SpaceScan.Trees.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SpaceScan Trees" Icon="/Assets/SpaceScanTrees-white.ico" Width="1250" Height="850" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F4F8F4">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
        <Border x:Name="StartupPanel" Background="#F4F8F4">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <Image Source="/Assets/SpaceScanTrees-white.png" Width="112" Height="112" Margin="0,0,0,22" />
                <TextBlock Text="SpaceScan Trees" FontSize="29" FontWeight="SemiBold" Foreground="#174D3A" TextAlignment="Center" />
                <TextBlock x:Name="Status" Text="Starting…" Margin="0,15,0,20" FontSize="14" TextWrapping="Wrap" Foreground="#547364" TextAlignment="Center" />
                <ProgressBar x:Name="Progress" Width="260" Height="4" IsIndeterminate="True" Foreground="#2E8E67" />
                <Button x:Name="Retry" Content="Retry / 重試" Width="145" Height="42" Margin="0,22,0,0"
                        HorizontalAlignment="Center" Visibility="Collapsed" Click="Retry_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
