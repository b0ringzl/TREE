<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpaceScan.Trees.Desktop</AssemblyName>
    <ApplicationIcon>Assets\SpaceScanTrees-white.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <Resource Include="Assets\SpaceScanTrees-white.ico" />
    <Resource Include="Assets\SpaceScanTrees-white.png" />
  </ItemGroup>
</Project>
